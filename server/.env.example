# MongoDB connection string (the app appends /Chaty as the database name)
MONGODB_URL=mongodb+srv://user:password@cluster.example.mongodb.net

# Secret used to sign auth tokens — use a long random string
JWT_SECRET=replace-with-a-long-random-string

# OpenCode Go API key — create or renew it at https://opencode.ai/console
# Requests go to https://opencode.ai/inference/go/openai/v1 by default.
OPENCODE_API_KEY=your-opencode-go-key

# Optional: fall back to a generic OpenAI-compatible key and/or endpoint
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://opencode.ai/inference/go/openai/v1

# ImageKit (AI image generation + hosting)
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your-id
IMAGEKIT_PUBLIC_KEY=your-public-key
IMAGEKIT_PRIVATE_KEY=your-private-key

# Image generation providers, tried in order until one succeeds.
# IMAGE_PROVIDER=auto        (default) imagekit -> gemini -> openai
# IMAGE_PROVIDER=imagekit    only ImageKit AI generation
# IMAGE_PROVIDER=gemini      only Google Gemini image models
# IMAGE_PROVIDER=openai      only OpenAI images API
# Providers without credentials are skipped automatically.
IMAGE_PROVIDER=auto

# Google Gemini image generation (fallback provider).
# Create a key at https://aistudio.google.com/apikey
# GEMINI_API_KEY=your-gemini-key
# GEMINI_IMAGE_MODELS=gemini-3.1-flash-image,gemini-2.5-flash-image
# GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta/models

# OpenAI images API (optional fallback provider).
# OPENAI_API_KEY=sk-...
# OPENAI_IMAGE_MODEL=gpt-image-1

# Stripe (test keys work locally — see the Stripe CLI section below)
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_PRIVATE_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Optional social sign-in (must match the frontend VITE_GOOGLE_CLIENT_ID / VITE_APPLE_CLIENT_ID)
# GOOGLE_CLIENT_ID=your-id.apps.googleusercontent.com
# APPLE_CLIENT_ID=com.example.web

# Optional: frontend origin used for the Stripe redirect fallback
# CLIENT_URL=http://localhost:5173

# Server port
PORT=3001
