VITE_SERVER_URL=http://localhost:3001
# Google sign-in (Web Client ID from Google Cloud Console > APIs & Services > Credentials).
# Frontend + backend must share the same Client ID.
# VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_WEB_CLIENT_ID.apps.googleusercontent.com
# Apple sign-in (Services ID from Apple Developer > Identifiers).
# Frontend + backend must share the same Services ID, e.g. com.chatyy.web.
# VITE_APPLE_CLIENT_ID=
